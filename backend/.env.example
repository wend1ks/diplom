# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-long-random-value
DJANGO_DEBUG=False
# Comma-separated hostnames, without scheme. Example: your-api.onrender.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Full PostgreSQL connection URL supplied by the database provider
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE
# Comma-separated full frontend origins. Example: https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-api.onrender.com
FRONTEND_URL=http://localhost:5173
# Must match the callback URL registered in the GitHub OAuth app
GITHUB_REDIRECT_URI=http://127.0.0.1:8000/api/auth/github/callback/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional SMTP configuration for password reset emails
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Set to the persistent disk mount path on your backend host, e.g. /var/data/media
MEDIA_ROOT=media